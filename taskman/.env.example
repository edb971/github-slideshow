# Copy to .env and edit. Both the server and the `t` CLI read this file.

# Port for the web UI. The server only ever binds to 127.0.0.1.
PORT=7878

# Where the SQLite database lives. Default: ~/.local/share/taskman/tasks.db
# (or $XDG_DATA_HOME/taskman/tasks.db if XDG_DATA_HOME is set).
# TASKMAN_DB=/home/you/Dropbox/tasks.db

# ntfy push notifications. Leave NTFY_TOPIC empty to disable reminders.
# Pick a long, unguessable topic: on ntfy.sh anyone who knows it can read it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Only needed for a protected topic or a self-hosted server with auth.
# NTFY_TOKEN=

# Daily digest of today's list (local time, HH:MM). Empty disables it.
DIGEST_TIME=07:00

# Push timed tasks this many minutes before they are due (0 = at due time).
REMIND_BEFORE_MINUTES=0

# Optional: force a timezone, e.g. Europe/London. Defaults to the system zone.
# TZ=
